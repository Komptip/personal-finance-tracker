{
  "name": "personal-finance-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "test": "python3 -m unittest discover -s tests -v && tsx --test tests/*.test.ts",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "privacy": "python3 scripts/check_privacy.py --staged",
    "privacy:history": "python3 scripts/check_privacy.py --history",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^3.17.7",
    "papaparse": "^5.5.3",
    "vue-chartjs": "^5.3.2"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22"
  }
}
